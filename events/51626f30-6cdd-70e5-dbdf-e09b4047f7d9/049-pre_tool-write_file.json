        "\"\"\"Business logic layer for MusicVerse.",
        "",
        "Provides high-level functions for the MVP features.",
        "All functions use repository.py for data access.",
        "\"\"\"",
        "from typing import List, Optional",
        "from .models import Song, Playlist",
        "from .repository import (",
        "    get_all_songs,",
        "    get_song_by_id,",
        "    search_songs,",
        "    get_favorite_songs,",
        "    toggle_favorite,",
        "    create_playlist,",
        "    get_playlist_by_id,",
        "    get_playlist_songs,",
        "    add_song_to_playlist,",
        "    update_song_ecoutes,",
        "    get_songs_by_mood,",
        "    get_stats,",
        ")",
        "",
        "",
        "def search_songs(query: str, limit: Optional[int] = None) -> List[Song]:",
        "    \"\"\"Search songs by titre, artiste, album, genre, or humeur.",
        "    ",
        "    Args:",
        "        query: Search term (partial match).",
        "        limit: Maximum number of results to return.",
        "    ",
        "    Returns:",
        "        List of matching Song objects.",
        "    \"\"\"",
        "    return search_songs(query, limit)",
        "",
        "",
        "def get_all_songs_service() -> List[Song]:",
        "    \"\"\"Get all songs from the library.\"\"\"",
        "    return get_all_songs()",
        "",
        "",
        "def get_favorites() -> List[Song]:",
        "    \"\"\"Get all songs marked as favorites.\"\"\"",
        "    return get_favorite_songs()",
        "",
        "",
        "def set_favorite(song_id: int, is_favorite: bool) -> bool:",
        "    \"\"\"Set or unset a song as favorite.",
        "    ",
        "    Args:",
        "        song_id: ID of the song to update.",
        "        is_favorite: True to mark as favorite, False to unmark.",
        "    ",
        "    Returns:",
        "        The new favorite status.",
        "    ",
        "    Raises:",
        "        ValueError: If song_id does not exist.",
        "    \"\"\"",
        "    current_status = get_song_by_id(song_id).is_favorite if get_song_by_id(song_id) else None",
        "    if current_status is None:",
        "        raise ValueError(f\"Song with ID {song_id} not found\")",
        "    ",
        "    if current_status != is_favorite:",
        "        toggle_favorite(song_id)",
        "    return is_favorite",
        "",
        "",
        "def toggle_favorite(song_id: int) -> bool:",
        "    \"\"\"Toggle the favorite status of a song.",
        "    ",
        "    Args:",
        "        song_id: ID of the song to toggle.",
        "    ",
        "    Returns:",
        "        The new favorite status.",
        "    ",
        "    Raises:",
        "        ValueError: If song_id does not exist.",
        "    \"\"\"",
        "    return toggle_favorite(song_id)",
        "",
        "",
        "def create_playlist_by_mood(name: str, mood: str) -> Playlist:",
        "    \"\"\"Create a playlist containing all songs with the specified mood.",
        "    ",
        "    Args:",
        "        name: Name of the new playlist.",
        "        mood: Mood to filter songs by.",
        "    ",
        "    Returns:",
        "        The created Playlist object.",
        "    \"\"\"",
        "    playlist = create_playlist(name)",
        "    songs = get_songs_by_mood(mood)",
        "    ",
        "    for position, song in enumerate(songs):",
        "        add_song_to_playlist(playlist.id, song.id, position)",
        "    ",
        "    return playlist",
        "",
        "",
        "def find_similar_songs(song_id: int, limit: int = 3) -> List[Song]:",
        "    \"\"\"Find songs similar to the specified song.",
        "    ",
        "    Similarity is based on matching genre OR mood.",
        "    The source song is excluded from results.",
        "    ",
        "    Args:",
        "        song_id: ID of the source song.",
        "        limit: Maximum number of similar songs to return.",
        "    ",
        "    Returns:",
        "        List of similar Song objects (up to limit).",
        "    ",
        "    Raises:",
        "        ValueError: If song_id does not exist.",
        "    \"\"\"",
        "    source_song = get_song_by_id(song_id)",
        "    if source_song is None:",
        "        raise ValueError(f\"Song with ID {song_id} not found\")",
        "    ",
        "    all_songs = get_all_songs()",
        "    similar_songs = []",
        "    ",
        "    for song in all_songs:",
        "        if song.id == song_id:",
        "            continue  # Skip the source song itself",
        "        if song.genre == source_song.genre or song.humeur == source_song.humeur:",
        "            similar_songs.append(song)",
        "    ",
        "    # Sort by écoutes (descending) to get most popular similar songs first",
        "    similar_songs.sort(key=lambda s: s.ecoutes, reverse=True)",
        "    ",
        "    return similar_songs[:limit]",
        "",
        "",
        "def simulate_listens(song_id: int, count: int = 1) -> None:",
        "    \"\"\"Simulate listening to a song by incrementing its écoutes counter.",
        "    ",
        "    Args:",
        "        song_id: ID of the song.",
        "        count: Number of écoutes to add (default: 1).",
        "    ",
        "    Raises:",
        "        ValueError: If song_id does not exist.",
        "    \"\"\"",
        "    if get_song_by_id(song_id) is None:",
        "        raise ValueError(f\"Song with ID {song_id} not found\")",
        "    update_song_ecoutes(song_id, count)",
        "",
        "",
        "def get_statistics() -> dict:",
        "    \"\"\"Get library statistics.",
        "    ",
        "    Returns:",
        "        Dictionary with:",
        "        - top_artistes: List of top 3 artistes by song count",
        "        - top_genres: List of top 3 genres by song count",
        "        - most_listened: Most listened song (titre, artiste, écoutes)",
        "    \"\"\"",
        "    return get_stats()",
