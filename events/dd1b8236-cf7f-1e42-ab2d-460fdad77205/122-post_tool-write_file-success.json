      "content": [
        "<!DOCTYPE html>",
        "<html lang=\"fr\">",
        "<head>",
        "    <meta charset=\"UTF-8\">",
        "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
        "    <title>MusicVerse - {{ playlist.nom }}</title>",
        "    <link rel=\"stylesheet\" href=\"{{ url_for('library.static', filename='css/library.css') }}\">",
        "</head>",
        "<body>",
        "    <header class=\"header\">",
        "        <div class=\"header-content\">",
        "            <h1 class=\"logo\">MusicVerse</h1>",
        "            <nav class=\"nav\">",
        "                <a href=\"{{ url_for('library.library') }}\" class=\"nav-link\">Bibliothèque</a>",
        "                <a href=\"{{ url_for('playlists.list_playlists') }}\" class=\"nav-link active\">Playlists</a>",
        "            </nav>",
        "        </div>",
        "    </header>",
        "",
        "    <main class=\"main-content\">",
        "        <div class=\"container\">",
        "            <!-- Header -->",
        "            <section class=\"search-section\">",
        "                <div style=\"display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;\">",
        "                    <h2>{{ playlist.nom }}</h2>",
        "                    <a href=\"{{ url_for('playlists.list_playlists') }}\" ",
        "                       class=\"search-button\"",
        "                       style=\"padding: 0.5rem 1.25rem; background: #334155; color: #fff; text-decoration: none;\">",
        "                        ← Retour aux playlists",
        "                    </a>",
        "                </div>",
        "                <p style=\"color: #94a3b8; margin-top: 0.5rem;\">",
        "                    {{ songs|length }} chanson(s)",
        "                </p>",
        "            </section>",
        "",
        "            <!-- Song List -->",
        "            <section class=\"song-list\">",
        "                {% if songs %}",
        "                <table class=\"song-table\">",
        "                    <thead>",
        "                        <tr>",
        "                            <th class=\"col-favorite\"></th>",
        "                            <th class=\"col-title\">Titre</th>",
        "                            <th class=\"col-artist\">Artiste</th>",
        "                            <th class=\"col-album\">Album</th>",
        "                            <th class=\"col-genre\">Genre</th>",
        "                            <th class=\"col-mood\">Humeur</th>",
        "                            <th class=\"col-duration\">Durée</th>",
        "                            <th class=\"col-listens\">Écoutes</th>",
        "                        </tr>",
        "                    </thead>",
        "                    <tbody>",
        "                        {% for song in songs %}",
        "                        <tr class=\"song-row\" data-song-id=\"{{ song.id }}\">",
        "                            <td class=\"col-favorite\">",
        "                                <button class=\"favorite-button {% if song.is_favorite %}favorite{% else %}not-favorite{% endif %}\" ",
        "                                        data-song-id=\"{{ song.id }}\"",
        "                                        title=\"{% if song.is_favorite %}Retirer des favoris{% else %}Ajouter aux favoris{% endif %}\">",
        "                                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">",
        "                                        <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>",
        "                                    </svg>",
        "                                </button>",
        "                            </td>",
        "                            <td class=\"col-title\">{{ song.titre }}</td>",
        "                            <td class=\"col-artist\">{{ song.artiste }}</td>",
        "                            <td class=\"col-album\">{{ song.album }}</td>",
        "                            <td class=\"col-genre\">{{ song.genre }}</td>",
        "                            <td class=\"col-mood\">{{ song.humeur }}</td>",
        "                            <td class=\"col-duration\">{{ \"%d:%02d\"|format(song.duree // 60, song.duree % 60) }}</td>",
        "                            <td class=\"col-listens\">{{ song.ecoutes }}</td>",
        "                        </tr>",
        "                        {% endfor %}",
        "                    </tbody>",
        "                </table>",
        "                {% else %}",
        "                <div class=\"no-results\">",
        "                    Cette playlist ne contient aucune chanson.",
        "                </div>",
        "                {% endif %}",
        "            </section>",
        "        </div>",
        "    </main>",
        "",
        "    <script>",
        "        // Toggle favorite functionality",
        "        document.querySelectorAll('.favorite-button').forEach(button => {",
        "            button.addEventListener('click', async function(e) {",
        "                e.preventDefault();",
        "                const songId = this.dataset.songId;",
        "                const button = this;",
        "                ",
        "                // Optimistic update",
        "                const isCurrentlyFavorite = button.classList.contains('favorite');",
        "                button.classList.toggle('favorite');",
        "                button.classList.toggle('not-favorite');",
        "                ",
        "                // Update title",
        "                const newTitle = isCurrentlyFavorite ? 'Ajouter aux favoris' : 'Retirer des favoris';",
        "                button.setAttribute('title', newTitle);",
        "                ",
        "                try {",
        "                    const response = await fetch(`/library/toggle_favorite/${songId}`, {",
        "                        method: 'POST',",
        "                        headers: {",
        "                            'Content-Type': 'application/json',",
        "                        }",
        "                    });",
        "                    ",
        "                    if (!response.ok) {",
        "                        // Revert if request failed",
        "                        button.classList.toggle('favorite');",
        "                        button.classList.toggle('not-favorite');",
        "                        button.setAttribute('title', isCurrentlyFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris');",
        "                        ",
        "                        const error = await response.json();",
        "                        console.error('Error:', error);",
        "                    }",
        "                } catch (error) {",
        "                    // Revert on network error",
        "                    button.classList.toggle('favorite');",
        "                    button.classList.toggle('not-favorite');",
        "                    button.setAttribute('title', isCurrentlyFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris');",
        "                    console.error('Network error:', error);",
        "                }",
        "            });",
        "        });",
        "    </script>",
        "</body>",
        "</html>",
        ""
      ]
    },
