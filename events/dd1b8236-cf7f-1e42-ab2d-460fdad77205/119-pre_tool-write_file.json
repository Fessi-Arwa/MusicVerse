      "content": [
        "<!DOCTYPE html>",
        "<html lang=\"fr\">",
        "<head>",
        "    <meta charset=\"UTF-8\">",
        "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
        "    <title>MusicVerse - Playlists</title>",
        "    <link rel=\"stylesheet\" href=\"{{ url_for('library.static', filename='css/library.css') }}\">",
        "</head>",
        "<body>",
        "    <header class=\"header\">",
        "        <div class=\"header-content\">",
        "            <h1 class=\"logo\">MusicVerse</h1>",
        "            <nav class=\"nav\">",
        "                <a href=\"{{ url_for('library.library') }}\" class=\"nav-link\">Bibliothèque</a>",
        "                <a href=\"{{ url_for('playlists.list_playlists') }}\" class=\"nav-link active\">Playlists</a>",
        "            </nav>",
        "        </div>",
        "    </header>",
        "",
        "    <main class=\"main-content\">",
        "        <div class=\"container\">",
        "            <!-- Header -->",
        "            <section class=\"search-section\">",
        "                <h2>Mes Playlists</h2>",
        "            </section>",
        "",
        "            <!-- Error message if present -->",
        "            {% if error %}",
        "            <div class=\"error-message\" style=\"color: #ef4444; margin-bottom: 1rem; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border-radius: 0.375rem;\">",
        "                {{ error }}",
        "            </div>",
        "            {% endif %}",
        "",
        "            <!-- Create Playlist Form -->",
        "            <section class=\"create-playlist-form\" style=\"margin-bottom: 2rem;\">",
        "                <form action=\"{{ url_for('playlists.create_playlist') }}\" method=\"POST\" class=\"create-form\">",
        "                    <h3 style=\"margin-bottom: 1rem; color: #cbd5e1;\">Créer une playlist à partir d'une humeur</h3>",
        "                    <div style=\"display: flex; gap: 1rem; flex-wrap: wrap;\">",
        "                        <input type=\"text\" ",
        "                               name=\"name\" ",
        "                               placeholder=\"Nom de la playlist\"",
        "                               class=\"search-input\"",
        "                               required",
        "                               style=\"flex: 1; min-width: 200px;\">",
        "                        <select name=\"mood\" class=\"search-input\" required style=\"min-width: 200px;\">",
        "                            <option value=\"\" disabled selected>Choisir une humeur</option>",
        "                            <option value=\"Calme\">Calme</option>",
        "                            <option value=\"Énergique\">Énergique</option>",
        "                            <option value=\"Heureux\">Heureux</option>",
        "                            <option value=\"Triste\">Triste</option>",
        "                            <option value=\"Romantique\">Romantique</option>",
        "                            <option value=\"Motivé\">Motivé</option>",
        "                        </select>",
        "                        <button type=\"submit\" class=\"search-button\" style=\"padding: 0.875rem 1.5rem;\">",
        "                            Créer",
        "                        </button>",
        "                    </div>",
        "                </form>",
        "            </section>",
        "",
        "            <!-- Playlists List -->",
        "            <section class=\"playlists-list\">",
        "                {% if playlists %}",
        "                <table class=\"song-table\">",
        "                    <thead>",
        "                        <tr>",
        "                            <th class=\"col-title\">Nom</th>",
        "                            <th class=\"col-listens\">Nombre de chansons</th>",
        "                            <th class=\"col-duration\">Actions</th>",
        "                        </tr>",
        "                    </thead>",
        "                    <tbody>",
        "                        {% for playlist in playlists %}",
        "                        <tr class=\"song-row\">",
        "                            <td class=\"col-title\">{{ playlist.nom }}</td>",
        "                            <td class=\"col-listens\">",
        "                                {% set song_count = [] %}",
        "                                {% for p in playlists %}",
        "                                    {% if p.id == playlist.id %}",
        "                                        {% set nsongs = get_playlist_songs(p.id)|length %}",
        "                                    {% endif %}",
        "                                {% endfor %}",
        "                                {{ nsongs if nsongs is defined else 0 }}",
        "                            </td>",
        "                            <td class=\"col-duration\">",
        "                                <a href=\"{{ url_for('playlists.view_playlist', playlist_id=playlist.id) }}\" ",
        "                                   class=\"view-button\" ",
        "                                   style=\"color: #8b5cf6; text-decoration: none; font-weight: 500;\">",
        "                                    Voir les chansons",
        "                                </a>",
        "                            </td>",
        "                        </tr>",
        "                        {% endfor %}",
        "                    </tbody>",
        "                </table>",
        "                {% else %}",
        "                <div class=\"no-results\">",
        "                    Aucune playlist trouvée. Créez-en une à partir d'une humeur !",
        "                </div>",
        "                {% endif %}",
        "            </section>",
        "        </div>",
        "    </main>",
        "</body>",
        "</html>",
        ""
      ]
    }
  }
}
