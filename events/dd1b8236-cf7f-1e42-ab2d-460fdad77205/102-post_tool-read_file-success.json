        "    \"\"\"Get a playlist by its ID. Returns None if not found.\"\"\"",
        "    with get_db_connection() as conn:",
        "        cursor = conn.cursor()",
        "        cursor.execute(\"SELECT * FROM playlists WHERE id = ?\", (playlist_id,))",
        "        row = cursor.fetchone()",
